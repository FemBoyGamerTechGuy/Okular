type.text=1

# This program is tokenized by the Okular-written lexer (selfhost/lexer):
# --selfhost-lex routes the compiler's lexing phase through the compiled
# Okular tokenizer. Every token family rides along: keywords, hex and
# underscore literals, escaped text, bitwise operators, nested generics.

const.mask = 0xF0F0 | 0x000F

type.array<type.number, 3> xs = {1, 2, 3}
type.ptr<type.ptr<type.number>> pp = null

function.main() -> number {
    type.uint32 flags = mask & 0x0F00
    write(flags << 1)
    print
    write(~flags >> 4)
    print
    type.text msg = "tab:\tnl:\nquote:\""
    write(text.length(msg))
    print
    loop (i from 0 until 3) {
        write(xs[i] + i)
        print
    }
    when (pp == null and 1 << 2 + 3 == 32) {
        write("selfhost-ok")
        print
    }
    return 0
}

main()
