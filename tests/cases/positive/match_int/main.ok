type.text=1

function.grade(number.score) -> text {
    when (score) {
        90 to 100 { return "A" }
        80 to 89 { return "B" }
        70, 71, 72, 73, 74, 75, 76, 77, 78, 79 { return "C" }
        else { return "F" }
    }
}

type.number x = 75
write(grade(95))
write(" ")
write(grade(85))
write(" ")
write(grade(75))
write(" ")
write(grade(10))
print

# multi-pattern arms share one body
when (x) {
    1, 5, 75 { write("hit") print }
    else { write("miss") print }
}

# fixed-width subjects adapt literal patterns
type.uint8 u = 200
when (u) {
    200 { write("two hundred") print }
    0 to 199 { write("below") print }
    else { write("above") print }
}
