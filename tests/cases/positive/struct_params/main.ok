type.text=1

[source.files.use] = {
    "shapes"
}.end

function.run() -> number {
    type.Rect r = {{1, 2}, 10, 20}
    write(shapes.area(&r))
    print
    write(shapes.area_by_value(r))
    print

    shapes.grow(&r, 5, 10)
    write(shapes.area(&r))
    print
    write(r.w)
    print
    write(r.h)
    print

    type.Point pt = {3, 4}
    shapes.translate(&pt, 10, 20)
    write(pt.x)
    print
    write(pt.y)
    print

    write(shapes.manhattan(pt))
    print
    return 0
}

run()
