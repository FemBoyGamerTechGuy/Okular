# main.ok — runs the Okular-written tokenizer.
#
# With a file argument, it emits the machine token stream (the compiler
# bridge protocol, bootstrap/src/selfhost_bridge.c) — this is how the
# bootstrap compiler uses it via --selfhost-lex. With no argument it
# prints the human-readable stream of sample.ok.

type.text=1
[source.files.use] = {
    "lexer"
}.end

function.main() -> number {
    when (env.arg_count() > 1) {
        lexer.set_machine(1)
        lexer.tokenize(env.arg(1))
        return 0
    }
    type.number n = lexer.tokenize("sample.ok")
    write("tokens: ")
    write(n)
    print
    return 0
}

main()
