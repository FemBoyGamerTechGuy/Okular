type.text=1

# global f32 initializers fold with one single-precision rounding per op
type.f32 A = 1.5 + 2.5
type.f32 B = 0.1 * 3.0
type.f32 C = 2.0 - 0.5

function.run() -> number {
    write(A)
    print
    write(B)
    print
    write(C)
    print
    write(A + B)
    print
    return 0
}
run()
