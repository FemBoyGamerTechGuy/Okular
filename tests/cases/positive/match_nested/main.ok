type.text=1

function.grade(number.score) -> text {
    when (score) {
        90 to 100 { return "A" }
        else { return "below-A" }
    }
}

# a match inside an arm body of another match
when (grade(95)) {
    "A" {
        when (95) {
            90 to 99 { write("A in the 90s") print }
            100 { write("perfect") print }
            else { write("impossible") print }
        }
    }
    "below-A" { write("not an A") print }
    else { write("unreachable") print }
}

# a conditional when whose body opens with a match
type.number x = 5
when (x > 0) {
    when (x) {
        5 { write("positive five") print }
        else { write("positive other") print }
    }
}
else {
    write("negative or zero")
    print
}
