# io.ok — the Okular standard library: output conveniences (0.15)
#
# Thin, honest helpers over the write/print buffer model (spec §11) and
# the raw syscall floor (spec §6.6). `puts`-style functions compose the
# buffer flush exactly like hand-written write+print would — no hidden
# buffering, no second output path.
type.text=1

function.puts(text.s) -> number {
    # one line of text to stdout
    write(s)
    print
    return 0
}

function.putn(number.n) -> number {
    write(n)
    print
    return 0
}

function.putd(decimal.d) -> number {
    write(d)
    print
    return 0
}

function.putf(type.f32.f) -> number {
    write(f)
    print
    return 0
}

function.putb(bool.b) -> number {
    write(b)
    print
    return 0
}

function.eputs(text.s) -> number {
    # one line to stderr, unbuffered and independent of the output buffer
    sys.write(2, s + "\n")
    return 0
}

function.ewrite(text.s) -> number {
    # raw bytes to stderr, no newline
    sys.write(2, s)
    return 0
}
