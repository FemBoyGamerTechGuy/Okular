# main.ok — the Okular compiler driver, written in Okular (M5).
#
# Usage: okc <main.ok> [--out <path>]
#
# The complete pipeline in one native binary: project load (lexer +
# parser modules), semantic analysis, IR construction and folding, and
# direct x86-64 machine-code emission into a native ELF64 executable —
# no C compiler, no `as`, no `ld` anywhere in the chain.
#
# The runtime module (src/rt.ok) is compiled into every emitted program;
# it is located relative to this executable (build/output/ -> ../../src/).
type.text=1

[source.files.use] = {
    "toks",
    "parser",
    "sema",
    "ir",
    "opt",
    "emit",
    "arm",
    "elf",
    "fmt",
    "rt"
}.end

# ---- small path helpers ----
function.dirname(text.path) -> text {
    type.number n = text.length(path)
    loop (i from 0 until n) {
        when (text.byte_at(path, n - 1 - i) == 47) {
            when (i == n - 1) {
                return "/"
            }
            return text.slice(path, 0, n - 1 - i)
        }
    }
    return "."
}

function.basename(text.path) -> text {
    type.number n = text.length(path)
    loop (i from 0 until n) {
        when (text.byte_at(path, n - 1 - i) == 47) {
            return text.slice(path, n - i, n)
        }
    }
    return path
}

function.path_join(text.a, text.b) -> text {
    when (text.length(a) == 0) {
        return b
    }
    when (text.byte_at(a, text.length(a) - 1) == 47) {
        return a + b
    }
    return a + "/" + b
}

function.strip_quotes(text.sp) -> text {
    type.number n = text.length(sp)
    when (n >= 2) {
        return text.slice(sp, 1, n - 1)
    }
    return sp
}

# ---- flags ----
type.number dump_ir_flag = 0
type.number strict_mode = 0
type.number warn_mode = 0
type.number opt_level_flag = 0
type.number target_arm64 = 0

# ---- the used-module collection (prescan over the token buffer) ----
type.ptr<type.text> uses = null
type.number n_uses = 0
type.number uses_cap = 0

function.uses_reset() -> number {
    n_uses = 0
    return 0
}

# ---- the [libs.use] collection (spec §6.3): accumulates project-wide ----
type.ptr<type.text> libs = null
type.number n_libs = 0
type.number libs_cap = 0

function.push_lib(text.name) -> number {
    loop (i from 0 until n_libs) {
        when (libs[i] == name) {
            return 0
        }
    }
    when (n_libs == libs_cap) {
        type.number newcap = 8
        when (libs_cap > 0) {
            newcap = libs_cap * 2
        }
        type.ptr<type.text> nl = alloc<type.text>(newcap)
        loop (i from 0 until n_libs) {
            nl[i] = libs[i]
        }
        type.ptr<type.text> old = libs
        libs = nl
        libs_cap = newcap
        when (old != null) {
            release(old)
        }
    }
    libs[n_libs] = name
    n_libs = n_libs + 1
    return 0
}

function.push_use(text.name) -> number {
    when (n_uses == uses_cap) {
        type.number newcap = 8
        when (uses_cap > 0) {
            newcap = uses_cap * 2
        }
        type.ptr<type.text> nu = alloc<type.text>(newcap)
        loop (i from 0 until n_uses) {
            nu[i] = uses[i]
        }
        type.ptr<type.text> old = uses
        uses = nu
        uses_cap = newcap
        when (old != null) {
            release(old)
        }
    }
    uses[n_uses] = name
    n_uses = n_uses + 1
    return 0
}

function.prescan_uses() -> number {
    # extract `[source.files.use]` items from the loaded token buffer (a
    # light, tolerant scan — the real parser reports malformed columns)
    type.number n = toks.count()
    type.number i = 0
    loop (i < n) {
        when (toks.kind(i) != toks.K_LBRACKET) {
            i = i + 1
            continue
        }
        type.number j = i + 1
        when (j >= n or toks.kind(j) != toks.K_IDENT) {
            i = i + 1
            continue
        }
        type.text colpath = toks.spelling(j)
        j = j + 1
        loop (j + 1 < n and toks.kind(j) == toks.K_DOT and toks.kind(j + 1) == toks.K_IDENT) {
            colpath = colpath + "." + toks.spelling(j + 1)
            j = j + 2
        }
        when (j >= n or toks.kind(j) != toks.K_RBRACKET) {
            i = i + 1
            continue
        }
        j = j + 1
        when (j >= n or toks.kind(j) != toks.K_EQ) {
            i = i + 1
            continue
        }
        j = j + 1
        when (j >= n or toks.kind(j) != toks.K_LBRACE) {
            i = i + 1
            continue
        }
        j = j + 1
        when (colpath == "source.files.use") {
            loop (j < n) {
                type.number k = toks.kind(j)
                when (k == toks.K_TEXT) {
                    push_use(strip_quotes(toks.spelling(j)))
                }
                else when (k == toks.K_COMMA or k == toks.K_NL) {
                    # separators
                }
                else {
                    break
                }
                j = j + 1
            }
        }
        else when (colpath == "libs.use") {
            loop (j < n) {
                type.number k = toks.kind(j)
                when (k == toks.K_TEXT) {
                    push_lib(strip_quotes(toks.spelling(j)))
                }
                else when (k == toks.K_COMMA or k == toks.K_NL) {
                    # separators
                }
                else {
                    break
                }
                j = j + 1
            }
        }
        i = j
    }
    return 0
}

# ---- project loading ----
type.text proj_root = "."

type.number load_errors = 0

function.report_load_error(text.display, text.msg, number.required) -> number {
    # load-time errors carry no position; for optional modules (spec §36)
    # they are warnings and do not fail the build
    when (required == 1) {
        sys.write(2, display + ": error: " + msg + "\n")
        load_errors = 1
    }
    else {
        sys.write(2, display + ": warning: " + msg + "\n")
    }
    return 0
}

function.load_module(text.name, text.path, text.display, number.required) -> number {
    type.ptr<type.Mod> m = sema.new_mod(name, path, display, required)
    sema.push_mod(m)
    m.state = 2

    toks.load(path)
    when (toks.get_err_kind() != toks.ERR_NONE) {
        report_load_error(display, "unexpected byte in source.", required + strict_mode)
        m.state = 0
        m.broken = 1
        return 0
    }

    uses_reset()
    prescan_uses()
    parser.register_struct_names()

    loop (k from 0 until n_uses) {
        type.text dep = uses[k]
        type.ptr<type.Mod> ex = sema.find_mod(dep)
        when (ex != null) {
            when (ex.state == 2) {
                report_load_error(display, "cyclic source dependency: `" + dep + "` is being loaded (directly or indirectly).", required + strict_mode)
            }
            continue
        }
        type.text dep_path = path_join(proj_root, "src/" + dep + ".ok")
        when (fs.exists(dep_path) == false) {
            report_load_error(display, "source file `" + dep + "` was not found in `src/`.", required + strict_mode)
            continue
        }
        load_module(dep, dep_path, "src/" + dep + ".ok", required)
    }
    m.state = 1
    return 0
}

function.load_project(text.main_path) -> number {
    proj_root = dirname(main_path)
    when (basename(main_path) != "main.ok") {
        sys.write(2, "okc: the entry point must be `main.ok`.\n")
        return 1
    }
    load_module("main", main_path, "main.ok", 1)
    return 0
}

# ---- library resolution (spec §6.3, implemented in 0.15) ----
#
# A library IS a module: once its file is found, the ordinary module
# machinery namespaces it (`math.abs`, `text.upper`), type-checks it,
# and links it — no separate binding layer exists or is needed.
# Search order: the project's libs/ and deps/ first, then the standard
# library directory next to the compiler (the distribution's stdlib/ —
# the same relative discovery the runtime module uses).
function.resolve_libraries(text.exe_path) -> number {
    type.text exe_dir = dirname(exe_path)
    # a queue, not a single pass: a library may itself carry [libs.use],
    # and entries accumulated while loading resolve in later rounds
    type.number done = 0
    loop (done < n_libs) {
        type.number limit = n_libs
        loop (i from done until limit) {
            type.text name = libs[i]
            when (sema.find_mod(name) != null) {
                # already present: a src/ module or an earlier resolution won
                continue
            }
            type.text p1 = path_join(proj_root, "libs/" + name + ".ok")
            type.text p2 = path_join(proj_root, "deps/" + name + ".ok")
            type.text p3 = path_join(exe_dir, "../stdlib/" + name + ".ok")
            type.text lib_path = ""
            when (fs.exists(p1) == true) {
                lib_path = p1
            }
            else when (fs.exists(p2) == true) {
                lib_path = p2
            }
            else when (fs.exists(p3) == true) {
                lib_path = p3
            }
            when (lib_path == "") {
                report_load_error("libs/" + name, "library `" + name + "` was not found (looked in `libs/`, `deps/`, and the compiler's `stdlib/`).", strict_mode)
                continue
            }
            # found and explicitly requested: load REQUIRED — a resolved
            # library links (only an unresolvable name stays a warning in
            # normal mode, per spec §6.3)
            load_module(name, lib_path, "libs/" + name, 1)
        }
        done = limit
    }
    return 0
}

# the runtime module: compiled into every emitted program; resolved
# relative to this executable (build/output/ -> ../../src/rt.ok, a
# release tree's bin/ -> ../src/rt.ok, the repository's bin/ seed ->
# ../selfhost/compiler/src/rt.ok)
function.inject_runtime(text.exe_path) -> number {
    when (sema.find_mod("rt") != null) {
        return 0
    }
    type.text dir = dirname(exe_path)
    type.text cand1 = path_join(dir, "../../src/rt.ok")
    type.text cand2 = path_join(dir, "../src/rt.ok")
    type.text cand3 = path_join(dir, "../selfhost/compiler/src/rt.ok")
    type.text rt_path = ""
    when (fs.exists(cand1) == true) {
        rt_path = cand1
    }
    else when (fs.exists(cand2) == true) {
        rt_path = cand2
    }
    else when (fs.exists(cand3) == true) {
        rt_path = cand3
    }
    when (rt_path == "") {
        sys.write(2, "okc: cannot locate the runtime module `src/rt.ok` next to the compiler.\n")
        return 1
    }
    load_module("rt", rt_path, "src/rt.ok", 1)
    return 0
}

# ---- the optional-source scan (spec §36) ----
# every src/*.ok file that is not in any [source.files.use] list is
# loaded as an OPTIONAL module: parsed and checked (errors downgraded to
# warnings), never linked. Broken ones are reported as skipped. Uses
# sys.getdents over the raw getdents64(2) buffer format:
#   u64 ino | u64 off | u16 reclen | u8 type | char name[] | NUL
function.scan_optional_sources() -> number {
    type.text srcdir = path_join(proj_root, "src")
    when (fs.exists(srcdir) == false) {
        return 0
    }
    type.number fd = sys.open(srcdir, 0, 0)
    when (fd < 0) {
        return 0
    }
    type.ptr<type.byte> buf = sys.mmap(4096)
    when (buf == null) {
        sys.close(fd)
        return 0
    }
    loop (true) {
        type.number n = sys.getdents(fd, buf, 4000)
        when (n <= 0) {
            break
        }
        type.text blob = text.from_bytes(buf, n)
        type.number off = 0
        loop (off + 19 <= n) {
            type.number reclen = text.byte_at(blob, off + 16) + 256 * text.byte_at(blob, off + 17)
            when (reclen < 20 or off + reclen > n) {
                break
            }
            type.number e = off + 19
            loop (e < n and text.byte_at(blob, e) != 0) {
                e = e + 1
            }
            type.text name = text.slice(blob, off + 19, e)
            type.number nl = text.length(name)
            when (nl > 3 and name != "main.ok") {
                # ends with ".ok"?
                when (text.byte_at(name, nl - 1) == 107 and text.byte_at(name, nl - 2) == 111 and text.byte_at(name, nl - 3) == 46) {
                    type.text mod = text.slice(name, 0, nl - 3)
                    when (sema.find_mod(mod) == null) {
                        load_module(mod, path_join(srcdir, name), "src/" + name, 0)
                    }
                }
            }
            off = off + reclen
        }
    }
    sys.close(fd)
    return 0
}

# ---- phase B: parse every module ----
function.parse_all() -> number {
    loop (i from 0 until sema.mod_count()) {
        type.ptr<type.Mod> m = sema.mod_at(i)
        when (m.state != 1) {
            continue
        }
        toks.load(m.path)
        parser.begin()
        sema.set_cur_mod(m)
        sema.set_downgrade(sema.mod_downgrade(m))
        type.ptr<type.Node> file = parser.parse_file()
        m.ast = file
        type.number nerr = parser.error_count()
        when (nerr > 0) {
            loop (k from 0 until nerr) {
                sema.serr_line(parser.err_line_at(k), parser.err_col_at(k), parser.err_msg_at(k))
            }
            m.state = 0
            m.broken = 1
            continue
        }
        sema.canon_node(file)
        sema.set_downgrade(0)
    }
    sema.set_downgrade(0)
    return 0
}

# ---- IR + emission ----
type.ptr<type.ptr<type.IrModule>> irmods = null
type.number n_irmods = 0
type.number irmods_cap = 0

function.push_irmod(type.ptr<type.IrModule>.im) -> number {
    when (n_irmods == irmods_cap) {
        type.number newcap = 8
        when (irmods_cap > 0) {
            newcap = irmods_cap * 2
        }
        type.ptr<type.ptr<type.IrModule>> nm = alloc<type.ptr<type.IrModule>>(newcap)
        loop (i from 0 until n_irmods) {
            nm[i] = irmods[i]
        }
        type.ptr<type.ptr<type.IrModule>> old = irmods
        irmods = nm
        irmods_cap = newcap
        when (old != null) {
            release(old)
        }
    }
    irmods[n_irmods] = im
    n_irmods = n_irmods + 1
    return 0
}

function.build_ir() -> number {
    # IR for required modules only (spec §36: optional modules are checked,
    # then skipped — never linked)
    loop (i from 0 until sema.mod_count()) {
        type.ptr<type.Mod> m = sema.mod_at(i)
        when (m.state != 1 or m.required != 1) {
            continue
        }
        type.ptr<type.IrModule> im = ir.ir_build_module(m)
        when (im != null) {
            push_irmod(im)
        }
    }
    return 0
}

function.ensure_dir(text.path) -> number {
    # best-effort mkdir -p via sys.mkdir (EEXIST is fine)
    sys.mkdir(path, 493)
    return 0
}

function.mkdir_p(text.path) -> number {
    type.number n = text.length(path)
    loop (i from 0 until n) {
        when (text.byte_at(path, i) == 47 and i > 0) {
            ensure_dir(text.slice(path, 0, i))
        }
    }
    ensure_dir(path)
    return 0
}

# ---- the formatter mode (`okular fmt`) ----
#
# okular fmt <file>... [--check]   — formats files in place; --check
# reports and exits 1 when a file differs from its formatted form
# (never rewrites). The formatter is token-based and preserves line
# structure, so a formatted file always parses to the same AST.
function.run_fmt(number.argc) -> number {
    type.number check = 0
    type.number n_paths = 0
    type.ptr<type.text> paths = alloc<type.text>(argc)
    loop (ai from 2 until argc) {
        type.text a = env.arg(ai)
        when (a == "--check" or a == "-c") {
            check = 1
        }
        else {
            paths[n_paths] = a
            n_paths = n_paths + 1
        }
    }
    when (n_paths == 0) {
        sys.write(2, "usage: okular fmt <file.ok>... [--check]\n")
        return 2
    }
    type.number bad = 0
    loop (p from 0 until n_paths) {
        type.text path = paths[p]
        type.text formatted = fmt.format_file(path)
        when (formatted == "") {
            sys.write(2, "okular fmt: cannot read or tokenize `" + path + "`.\n")
            return 1
        }
        when (check == 1) {
            type.text orig = fs.read(path)
            when (orig != formatted) {
                sys.write(1, path + ": not formatted\n")
                bad = bad + 1
            }
        }
        else {
            type.text orig = fs.read(path)
            when (orig != formatted) {
                fs.save(path, formatted)
                sys.write(1, "okular fmt: formatted " + path + "\n")
            }
        }
    }
    when (check == 1 and bad > 0) {
        sys.write(2, "okular fmt: " + number.to_text(bad) + " file(s) need formatting\n")
        return 1
    }
    return 0
}

# ---- the driver ----
function.main() -> number {
    type.number argc = env.arg_count()
    when (argc >= 2 and env.arg(1) == "fmt") {
        return run_fmt(argc)
    }
    when (argc < 2) {
        sys.write(2, "usage: okc <main.ok> [--out <path>] [--dump-ir] [-O1 | -O2] [--opt-stats] [-s | --strict] [-w | --warnings]\n")
        return 2
    }
    type.text main_path = env.arg(1)
    type.text out_path = ""

    # flags: --out <path>, --dump-ir, -s/--strict (any order)
    type.number ai = 2
    loop (ai < argc) {
        type.text a = env.arg(ai)
        when (a == "--out") {
            ai = ai + 1
            when (ai < argc) {
                out_path = env.arg(ai)
            }
        }
        else when (a == "--dump-ir") {
            dump_ir_flag = 1
        }
        else when (a == "-s" or a == "--strict") {
            strict_mode = 1
        }
        else when (a == "-w" or a == "--warnings") {
            warn_mode = 1
        }
        else when (a == "-O" or a == "-O1") {
            opt_level_flag = 1
        }
        else when (a == "-O2") {
            opt_level_flag = 2
        }
        else when (a == "--opt-stats") {
            opt.opt_stats = 1
        }
        else when (a == "--trace-emit") {
            emit.set_trace_emit(1)
        }
        else when (a == "--target") {
            ai = ai + 1
            when (ai < argc) {
                type.text tgt = env.arg(ai)
                when (tgt == "arm64" or tgt == "aarch64") {
                    target_arm64 = 1
                }
                else when (tgt == "x86-64" or tgt == "x86_64") {
                    target_arm64 = 0
                }
                else {
                    sys.write(2, "okc: unknown target `" + tgt + "` (supported: x86-64, arm64).\n")
                    return 2
                }
            }
        }
        else {
            sys.write(2, "okc: unknown flag `" + a + "`.\n")
            return 2
        }
        ai = ai + 1
    }
    when (strict_mode == 1) {
        sema.set_strict(1)
    }
    when (warn_mode == 1) {
        sema.set_warn(1)
    }

    sema.init_types()
    sema.diag_reset()
    elf.sym_reset()

    when (load_project(main_path) != 0) {
        return 2
    }
    when (resolve_libraries(env.arg(0)) != 0) {
        return 1
    }
    when (inject_runtime(env.arg(0)) != 0) {
        return 1
    }
    scan_optional_sources()

    parse_all()

    type.number pre_errors = sema.error_count()
    when (sema.sema_run() == 0 or pre_errors > 0 or load_errors == 1) {
        sema.render_all()
        sys.write(2, "okular: compilation failed; no executable was produced.\n")
        return 1
    }

    build_ir()

    # the optimizer (spec §15): -O1 runs the IR pass pipeline, -O2 also
    # switches the backend to register-cached emission. The default build
    # (no -O) is the plain stack machine — the bootstrap seed and `make`
    # reproduction path never depend on optimizer behavior.
    when (opt_level_flag > 0) {
        opt.optimize(irmods, n_irmods, opt_level_flag)
    }
    # -O2 register-cached emission is x86-64 only for now; on arm64 it
    # falls back to the -O1 IR passes (honest capability reporting)
    when (opt_level_flag >= 2 and target_arm64 == 0) {
        emit.set_regmode(1)
    }

    when (dump_ir_flag == 1) {
        loop (i from 0 until n_irmods) {
            type.ptr<type.IrModule> im = irmods[i]
            loop (k from 0 until im.nfuncs) {
                ir.dump_func(im.funcs[k])
            }
        }
    }

    # pre-pass: symbols for every function and global (calls may precede
    # definitions); then the entry stub (main.ok's top-level statements)
    loop (i from 0 until n_irmods) {
        emit.prepass_module(irmods[i])
    }
    type.number entry_sym = emit.sym_by_name("__ok_entry")
    when (entry_sym < 0) {
        sys.write(2, "okular: main.ok has no entry point — add top-level statements.\n")
        return 1
    }
    when (target_arm64 == 1) {
        elf.set_machine(183)
        arm.a_emit_start(entry_sym)
        loop (i from 0 until n_irmods) {
            arm.a_emit_module(irmods[i])
        }
    }
    else {
        emit.emit_start(entry_sym)
        loop (i from 0 until n_irmods) {
            emit.emit_module(irmods[i])
        }
    }

    when (out_path == "") {
        out_path = path_join(proj_root, "build/output/main")
        mkdir_p(path_join(proj_root, "build"))
        mkdir_p(path_join(proj_root, "build/output"))
    }

    when (elf.emit_elf(out_path) != 0) {
        sys.write(2, "okc: cannot write `" + out_path + "`.\n")
        return 1
    }
    sys.chmod(out_path, 493)

    when (emit.emit_failed_flag() == 1) {
        sema.render_all()
        sys.write(2, "okular: compilation failed; no executable was produced.\n")
        return 1
    }

    # report skipped optional modules (the normal-mode summary)
    loop (i from 0 until sema.mod_count()) {
        type.ptr<type.Mod> m = sema.mod_at(i)
        when (m.broken == 1 and m.required != 1) {
            sys.write(2, "okular: note: src/" + m.name + ".ok was skipped (broken and unused).\n")
        }
    }

    sema.render_all()
    sys.write(2, "okular: wrote " + out_path + "\n")
    return 0
}

return main()
