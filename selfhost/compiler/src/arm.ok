# arm.ok — the ARM64 (AArch64) native backend (0.17).
#
# The second target: the same typed stack IR, the same Okular Internal
# ABI semantics (args in the first six registers, decimal as raw bits in
# a register, text as a (ptr,len) pair behind one register, arrays
# caller-copied), lowered to AArch64 machine code — fixed 4-byte
# instructions, NZCV condition codes, sp kept 16-byte aligned by giving
# every operand-stack slot 16 bytes (push = sub+str, pop = ldr+add).
#
# The classic stack machine only (no register-cached mode): -O2 on this
# target falls back to the -O1 IR passes. Absolute addresses materialize
# as movz/movk chains patched by the ABS64_ARM fixup; branches and calls
# use the REL26 fixup; ELF images carry e_machine = EM_AARCH64 (183).
#
# Registers: x0-x5 arguments/results, x9-x17 scratch (the stack machine
# stages values through x0/x1/x2 like the x86 rax/rcx/rdx discipline),
# x29 = frame base (bottom of the frame, positive offsets), x30 = LR.
# ---- condition codes (NZCV selectors) ----
const.A_EQ = 0
const.A_NE = 1
const.A_CS = 2
const.A_CC = 3
const.A_MI = 4
const.A_PL = 5
const.A_VS = 6
const.A_VC = 7
const.A_LO = 3
const.A_HI = 8
const.A_LS = 9
const.A_HS = 2
const.A_GE = 10
const.A_LT = 11
const.A_GT = 12
const.A_LE = 13

# ---- registers ----
const.AX0 = 0
const.AX1 = 1
const.AX2 = 2
const.AX3 = 3
const.AX4 = 4
const.AX5 = 5
const.AX8 = 8
const.AX9 = 9
const.AX10 = 10
const.AX11 = 11
const.AX12 = 12
const.AX29 = 29
const.AX30 = 30
const.ASP = 31
const.AXZR = 31

# ---- word emission ----
function.a_put(number.w) -> number {
    elf.buf_put32(elf.code, w & 4294967295)
    return 0
}

function.a_code_len() -> number {
    return elf.code_len()
}

# ---- local labels with imm26 backpatching (mirrors emit.ok) ----
type.ptr<type.number> a_lbl_pos = null
type.number a_lbl_n = 0
type.number a_lbl_cap = 0
type.ptr<type.number> a_jsite_lbl = null
type.ptr<type.number> a_jsite_at = null
type.ptr<type.number> a_jsite_kind = null
type.number a_n_jsite = 0
type.number a_jsite_cap = 0

const.A_TRAP_BASE = 1000000

function.a_label_reserve(number.n) -> number {
    when (n > a_lbl_cap) {
        type.number newcap = 16
        when (a_lbl_cap > 0) {
            newcap = a_lbl_cap * 2
        }
        loop (n > newcap) {
            newcap = newcap * 2
        }
        type.ptr<type.number> np = alloc<type.number>(newcap)
        loop (i from 0 until a_lbl_n) {
            np[i] = a_lbl_pos[i]
        }
        type.ptr<type.number> old = a_lbl_pos
        a_lbl_pos = np
        a_lbl_cap = newcap
        when (old != null) {
            release(old)
        }
    }
    loop (i from a_lbl_n until n) {
        a_lbl_pos[i] =-1
    }
    when (n > a_lbl_n) {
        a_lbl_n = n
    }
    return 0
}

function.a_trap_lbl(number.n) -> number {
    return A_TRAP_BASE + n
}

function.a_label_here(number.lbl) -> number {
    a_label_reserve(lbl + 1)
    a_lbl_pos[lbl] = a_code_len()
    return 0
}

function.a_jmp_site_at(number.lbl, number.at) -> number {
    # default kind 0: b / b.cond / bl (imm26 at bits 25:0)
    return a_jmp_site_kind(lbl, at, 0)
}

function.a_jmp_site_kind(number.lbl, number.at, number.kind) -> number {
    when (a_n_jsite == a_jsite_cap) {
        type.number newcap = 32
        when (a_jsite_cap > 0) {
            newcap = a_jsite_cap * 2
        }
        type.ptr<type.number> nl = alloc<type.number>(newcap)
        type.ptr<type.number> na = alloc<type.number>(newcap)
        type.ptr<type.number> nk = alloc<type.number>(newcap)
        loop (i from 0 until a_n_jsite) {
            nl[i] = a_jsite_lbl[i]
            na[i] = a_jsite_at[i]
            nk[i] = a_jsite_kind[i]
        }
        type.ptr<type.number> ol = a_jsite_lbl
        type.ptr<type.number> oa = a_jsite_at
        type.ptr<type.number> ok2 = a_jsite_kind
        a_jsite_lbl = nl
        a_jsite_at = na
        a_jsite_kind = nk
        a_jsite_cap = newcap
        when (ol != null) {
            release(ol)
            release(oa)
            release(ok2)
        }
    }
    a_jsite_lbl[a_n_jsite] = lbl
    a_jsite_at[a_n_jsite] = at
    a_jsite_kind[a_n_jsite] = kind
    a_n_jsite = a_n_jsite + 1
    return 0
}

function.a_patch_jumps() -> number {
    loop (i from 0 until a_n_jsite) {
        type.number lbl = a_jsite_lbl[i]
        type.number at = a_jsite_at[i]
        type.number kind = a_jsite_kind[i]
        type.number target = a_lbl_pos[lbl]
        type.number rel = (target - at - 4) / 4
        type.number word = elf.buf_rd32_at(elf.code, at)
        when (kind == 1) {
            # cbz/cbnz: imm19 at bits 23:5, register at 4:0
            word = (word & 4278190080) | ((rel & 524287) << 5) | (word & 31)
        }
        else when (kind == 2) {
            # b.cond: imm19 at bits 23:5, bit 4 = 0, cond at 3:0
            word = (word & 4278190111) | ((rel & 524287) << 5)
        }
        else {
            # b / bl: imm26 at bits 25:0
            word = (word & 4261412864) | (rel & 67108863)
        }
        elf.buf_wr32_at(elf.code, at, word)
    }
    a_n_jsite = 0
    return 0
}

# ---- primitive encoders ----
# MOVZ Xd, #imm16, LSL #hw*16
function.a_movz(number.rd, number.imm16, number.hw) -> number {
    a_put(0xD2800000 + (hw << 21) + ((imm16 & 65535) << 5) + rd)
    return 0
}

# MOVK Xd, #imm16, LSL #hw*16
function.a_movk(number.rd, number.imm16, number.hw) -> number {
    a_put(0xF2800000 + (hw << 21) + ((imm16 & 65535) << 5) + rd)
    return 0
}

# materialize an arbitrary 64-bit immediate (positive patterns only; the
# compiler's numbers are wrapping two's-complement, and bit patterns are
# built with the same movz/movk chain the fixup uses)
function.a_mov_imm(number.rd, number.v) -> number {
    type.number w0 = v & 65535
    type.number w1 = (v >> 16) & 65535
    type.number w2 = (v >> 32) & 65535
    type.number w3 = (v >> 48) & 65535
    a_movz(rd, w0, 0)
    when (w1 != 0 or w2 != 0 or w3 != 0) {
        a_movk(rd, w1, 1)
    }
    when (w2 != 0 or w3 != 0) {
        a_movk(rd, w2, 2)
    }
    when (w3 != 0) {
        a_movk(rd, w3, 3)
    }
    return 0
}

# MOV Xd, Xm (ORR Xd, XZR, Xm)
function.a_mov(number.rd, number.rm) -> number {
    a_put(0xAA0003E0 + (rm << 16) + rd)
    return 0
}

# ADD Xd, Xn, Xm
function.a_add(number.rd, number.rn, number.rm) -> number {
    a_put(0x8B000000 + (rm << 16) + (rn << 5) + rd)
    return 0
}

# SUB Xd, Xn, Xm
function.a_sub(number.rd, number.rn, number.rm) -> number {
    a_put(0xCB000000 + (rm << 16) + (rn << 5) + rd)
    return 0
}

# ADDS Xd, Xn, Xm (flags)
function.a_adds(number.rd, number.rn, number.rm) -> number {
    a_put(0xAB000000 + (rm << 16) + (rn << 5) + rd)
    return 0
}

# SUBS Xd, Xn, Xm (flags)
function.a_subs(number.rd, number.rn, number.rm) -> number {
    a_put(0xEB000000 + (rm << 16) + (rn << 5) + rd)
    return 0
}

# CMP Xn, Xm (SUBS XZR, Xn, Xm)
function.a_cmp(number.rn, number.rm) -> number {
    a_subs(31, rn, rm)
    return 0
}

# ADD Xd, Xn, #imm12 (imm <= 4095)
function.a_add_i(number.rd, number.rn, number.imm12) -> number {
    a_put(0x91000000 + ((imm12 & 4095) << 10) + (rn << 5) + rd)
    return 0
}

# SUB Xd, Xn, #imm12
function.a_sub_i(number.rd, number.rn, number.imm12) -> number {
    a_put(0xD1000000 + ((imm12 & 4095) << 10) + (rn << 5) + rd)
    return 0
}

# SUBS Xd, Xn, #imm12
function.a_subs_i(number.rd, number.rn, number.imm12) -> number {
    a_put(0xF1000000 + ((imm12 & 4095) << 10) + (rn << 5) + rd)
    return 0
}

# CMP Xn, #imm12 (SUBS XZR, Xn, #imm12)
function.a_cmp_i(number.rn, number.imm12) -> number {
    a_subs_i(31, rn, imm12)
    return 0
}

# AND/ORR/EOR Xd, Xn, Xm
function.a_and(number.rd, number.rn, number.rm) -> number {
    a_put(0x8A000000 + (rm << 16) + (rn << 5) + rd)
    return 0
}

function.a_or(number.rd, number.rn, number.rm) -> number {
    a_put(0xAA000000 + (rm << 16) + (rn << 5) + rd)
    return 0
}

function.a_eor(number.rd, number.rn, number.rm) -> number {
    a_put(0xCA000000 + (rm << 16) + (rn << 5) + rd)
    return 0
}

# MVN Xd, Xm (ORN Xd, XZR, Xm)
function.a_mvn(number.rd, number.rm) -> number {
    a_put(0xAA2003E0 + (rm << 16) + rd)
    return 0
}

# NEG Xd, Xm (SUB Xd, XZR, Xm)
function.a_neg(number.rd, number.rm) -> number {
    a_sub(rd, 31, rm)
    return 0
}

# MUL Xd, Xn, Xm (MADD Xd, Xn, Xm, XZR)
function.a_mul(number.rd, number.rn, number.rm) -> number {
    a_put(0x9B007C00 + (rm << 16) + (rn << 5) + rd)
    return 0
}

# MSUB Xd, Xn, Xm, Xa
function.a_msub(number.rd, number.rn, number.rm, number.ra) -> number {
    a_put(0x9B008000 + (rm << 16) + (ra << 10) + (rn << 5) + rd)
    return 0
}

# SDIV / UDIV Xd, Xn, Xm
function.a_sdiv(number.rd, number.rn, number.rm) -> number {
    a_put(0x9AC00C00 + (rm << 16) + (rn << 5) + rd)
    return 0
}

function.a_udiv(number.rd, number.rn, number.rm) -> number {
    a_put(0x9AC00800 + (rm << 16) + (rn << 5) + rd)
    return 0
}

# LSLV/LSRV/ASRV Xd, Xn, Xm
function.a_lslv(number.rd, number.rn, number.rm) -> number {
    a_put(0x9AC02000 + (rm << 16) + (rn << 5) + rd)
    return 0
}

function.a_lsrv(number.rd, number.rn, number.rm) -> number {
    a_put(0x9AC02400 + (rm << 16) + (rn << 5) + rd)
    return 0
}

function.a_asrv(number.rd, number.rn, number.rm) -> number {
    a_put(0x9AC02800 + (rm << 16) + (rn << 5) + rd)
    return 0
}

# CSET Xd, cc (CSINC Xd, XZR, XZR, ~cc)
function.a_cset(number.rd, number.cc) -> number {
    a_put(0x9A800400 + (31 << 16) + (((cc ^ 1) & 15) << 12) + (31 << 5) + rd)
    return 0
}

# ---- branches ----
function.a_b(number.lbl) -> number {
    type.number at = a_code_len()
    a_put(0x14000000)
    a_jmp_site_at(lbl, at)
    return 0
}

function.a_bcc(number.cc, number.lbl) -> number {
    # b.cond: imm19 at bits 23:5 (bit 4 fixed 0), cond at 3:0
    type.number at = a_code_len()
    a_put(0x54000000 + (cc & 15))
    a_jmp_site_kind(lbl, at, 2)
    return 0
}

function.a_bls(number.lbl) -> number {
    a_bcc(A_LS, lbl)
    return 0
}

function.a_bvs(number.lbl) -> number {
    a_bcc(A_VS, lbl)
    return 0
}

function.a_bpl(number.lbl) -> number {
    a_bcc(A_PL, lbl)
    return 0
}

function.a_ble(number.lbl) -> number {
    a_bcc(A_LE, lbl)
    return 0
}

function.a_bl_lbl(number.lbl) -> number {
    type.number at = a_code_len()
    a_put(0x94000000)
    a_jmp_site_at(lbl, at)
    return 0
}

function.a_cbz(number.rt, number.lbl) -> number {
    type.number at = a_code_len()
    a_put(0xB4000000 + rt)
    a_jmp_site_kind(lbl, at, 1)
    return 0
}

function.a_cbnz(number.rt, number.lbl) -> number {
    type.number at = a_code_len()
    a_put(0xB5000000 + rt)
    a_jmp_site_kind(lbl, at, 1)
    return 0
}

function.a_bl_sym(number.sym) -> number {
    type.number at = a_code_len()
    a_put(0x94000000)
    elf.fx_rel26(0, at, sym)
    return 0
}

function.a_ret() -> number {
    a_put(0xD65F03C0)
    return 0
}

function.a_svc() -> number {
    a_put(0xD4000001)
    return 0
}

# ---- loads/stores (unsigned offset, scaled) ----
# STR Xt, [Xn, #imm] (imm multiple of 8, <= 32760)
function.a_str_x(number.rt, number.rn, number.off) -> number {
    a_put(0xF9000000 + (((off / 8) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

function.a_ldr_x(number.rt, number.rn, number.off) -> number {
    a_put(0xF9400000 + (((off / 8) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

# STR Wt, [Xn, #imm] (multiple of 4, <= 16380)
function.a_str_w(number.rt, number.rn, number.off) -> number {
    a_put(0xB9000000 + (((off / 4) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

function.a_ldr_w(number.rt, number.rn, number.off) -> number {
    a_put(0xB9400000 + (((off / 4) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

# STRH / LDRH (multiple of 2)
function.a_str_h(number.rt, number.rn, number.off) -> number {
    a_put(0x79000000 + (((off / 2) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

function.a_ldr_h(number.rt, number.rn, number.off) -> number {
    a_put(0x79400000 + (((off / 2) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

# STRB / LDRB (any byte offset)
function.a_str_b(number.rt, number.rn, number.off) -> number {
    a_put(0x39000000 + ((off & 4095) << 10) + (rn << 5) + rt)
    return 0
}

function.a_ldr_b(number.rt, number.rn, number.off) -> number {
    a_put(0x39400000 + ((off & 4095) << 10) + (rn << 5) + rt)
    return 0
}

# sign-extending loads
function.a_ldrsb_x(number.rt, number.rn, number.off) -> number {
    a_put(0x39800000 + ((off & 4095) << 10) + (rn << 5) + rt)
    return 0
}

function.a_ldrsb_w(number.rt, number.rn, number.off) -> number {
    a_put(0x39C00000 + ((off & 4095) << 10) + (rn << 5) + rt)
    return 0
}

function.a_ldrsh_x(number.rt, number.rn, number.off) -> number {
    a_put(0x79800000 + (((off / 2) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

function.a_ldrsh_w(number.rt, number.rn, number.off) -> number {
    a_put(0x79C00000 + (((off / 2) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

function.a_ldrsw_x(number.rt, number.rn, number.off) -> number {
    a_put(0xB9800000 + (((off / 4) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

# register-offset byte load: LDRB Wt, [Xn, Xm]
function.a_ldr_b_reg(number.rt, number.rn, number.rm) -> number {
    a_put(0x38606800 + (rm << 16) + (rn << 5) + rt)
    return 0
}

# SIMD loads/stores: STR Dt, [Xn, #off] / LDR Dt (64-bit SIMD slot)
function.a_str_d(number.rt, number.rn, number.off) -> number {
    a_put(0xFD000000 + (((off / 8) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

function.a_ldr_d(number.rt, number.rn, number.off) -> number {
    a_put(0xFD400000 + (((off / 8) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

function.a_str_s(number.rt, number.rn, number.off) -> number {
    a_put(0xBD000000 + (((off / 4) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

function.a_ldr_s(number.rt, number.rn, number.off) -> number {
    a_put(0xBD400000 + (((off / 4) & 4095) << 10) + (rn << 5) + rt)
    return 0
}

# ---- SIMD data processing ----
function.a_fmov_dd(number.rd, number.rn) -> number {
    a_put(0x1E604000 + (rn << 5) + rd)
    return 0
}

function.a_fmov_ss(number.rd, number.rn) -> number {
    a_put(0x1E204000 + (rn << 5) + rd)
    return 0
}

